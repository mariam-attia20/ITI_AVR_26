#include "../../LIB/STD_TYPES.h"
#include "../../LIB/BIT_MATH.h"
#include "TWI_int.h"
#include "TWI_prv.h"

void MTWI_vInit(void)
{


	TWBR = 32 ;
}

u8 MTWI_u8SendStartCondition(void)
{
	TWCR = (1 << TWINT)|(1 << TWSTA)|(1<<TWEN);

	while(!(TWCR & (1<<TWINT)));

	return (TWSR & 0xF8);



}

u8 MTWI_u8ReSendStartCondition(void)
{

	TWCR = (1 << TWINT)|(1 << TWSTA)|(1<<TWEN);

		while(!(TWCR & (1<<TWINT)));

		return (TWSR & 0xF8);

}

u8 MTWI_u8SendEndCondition(void)
{
	TWCR = (1 << TWINT)|(1 << TWSTA)|(1<<TWSTO);

	return (TWSR & 0xF8);

}

u8 MTWI_u8SendSLA_RW(u8 A_u8SLA , u8 A_u8RW)
{
	TWDR = ( A_u8SLA << 1)|( A_u8RW) ;

	TWCR = (1<<TWINT) | (1<<TWEN);

	CLR_BIT(TWCR , TWSTA);

	while (!(TWCR & (1<<TWINT)));

	return (TWSR & 0xF8);


}

u8 MTWI_u8SendByte(u8 A_u8Byte)
{
	TWDR = A_u8Byte;
	TWCR = (1<<TWINT) | (1<<TWEN);

	while (!(TWCR & (1<<TWINT)));

		return (TWSR & 0xF8);


}

