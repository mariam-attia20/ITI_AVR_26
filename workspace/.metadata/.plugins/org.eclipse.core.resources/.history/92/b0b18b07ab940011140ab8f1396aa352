#include "../FreeRTOS/FreeRTOS.h"
#include "../FreeRTOS/task.h"

#include "../LIB/STD_TYPES.h"
#include "../MCAL/DIO/DIO_int.h"

void TASK_LED1(void *A_Pv){
	while(1){

	MDIO_vTogPinVal(DIO_PORTA , DIO_PIN0);
	//takes number of ticks
	//200 msec -> # of ticks = 200/1 = 200  ticks
	vTaskDelay(200);
	}
}
void TASK_LED2(void *A_Pv)
{
	while(1){

		MDIO_vTogPinVal(DIO_PORTA , DIO_PIN1);
		//takes number of ticks
		//200 msec -> # of ticks = 200/1 = 200  ticks
		vTaskDelay(1000);
		}

}

int main()
{
	MDIO_vSetPinDir(DIO_PORTA , DIO_PIN0 , DIO_OUTPUT);
	MDIO_vSetPinDir(DIO_PORTA , DIO_PIN1 , DIO_OUTPUT);
	xTaskCreate(TASK_LED1 , (signed const char *)"LED1" ,
			100 , NULL , 1 , NULL);
	xTaskCreate(TASK_LED2 , (signed const char *)"LED2" ,
				100 , NULL , 2 , NULL);
	vTaskStartScheduler();
	while(1)
	{
	}

	return 0 ;

}

