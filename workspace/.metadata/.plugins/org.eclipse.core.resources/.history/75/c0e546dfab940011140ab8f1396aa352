#include "../FreeRTOS/FreeRTOS.h"
#include "../FreeRTOS/task.h"

#include "../LIB/STD_TYPES.h"
#include "../MCAL/DIO/DIO_int.h"
#include "../HAL/LCD/LCD_int.h"


void TASK_LCD1(void *A_Pv){
	while(1){

	MDIO_vTogPinVal(DIO_PORTA , DIO_PIN0);
	//takes number of ticks
	//200 msec -> # of ticks = 200/1 = 200  ticks
	vTaskDelay(200);
	}
}
void TASK_LCD2(void *A_Pv)
{
	while(1){

		MDIO_vTogPinVal(DIO_PORTA , DIO_PIN1);
		//takes number of ticks
		//200 msec -> # of ticks = 200/1 = 200  ticks
		vTaskDelay(1000);
		}

}

int main()
{
	HLCD_vInit();

	xTaskCreate(TASK_LCD1, (signed const char *)"LED1" ,
			100 , NULL , 1 , NULL);
	xTaskCreate(TASK_LCD2 , (signed const char *)"LED2" ,
				100 , NULL , 1 , NULL);
	vTaskStartScheduler();
	while(1)
	{
	}

	return 0 ;

}

