void HLCD_vInit(void)
{
	MDIO_vSetPortDir(LCD_DATA_PORT, DIO_PORT_OUTPUT);

	MDIO_vSetPinDir(LCD_CTRL_PORT, LCD_RS, DIO_OUTPUT);
	MDIO_vSetPinDir(LCD_CTRL_PORT, LCD_RW, DIO_OUTPUT);
	MDIO_vSetPinDir(LCD_CTRL_PORT, LCD_E, DIO_OUTPUT);


	_delay_ms(50);
	HLCD_vSendCmd(0x38);

	_delay_ms(1);
	HLCD_vSendCmd(0x0C);

	_delay_ms(1);
	HLCD_vSendCmd(0x01);

	_delay_ms(2);
	HLCD_vSendCmd(0x06);
}
void HLCD_vSendCmd( u8 A_u8Cmd){
	//control RS to send command //connected to A0
	MDIO_vSetPinVal(DIO_PORTA , DIO_PIN0, DIO_LOW);
	// RW -> write
	MDIO_vSetPinVal(DIO_PORTA , DIO_PIN1 , DIO_LOW);
	// write data
	MDIO_vSetPortVal( DIO_PORTD, A_u8Cmd);
	//enable pulse
	MDIO_vSetPinVal(DIO_PORTA , DIO_PIN2, DIO_HIGH);
	_delay_ms(1);
	MDIO_vSetPinVal(DIO_PORTA , DIO_PIN2, DIO_LOW);
	_delay_ms(1);

}

void HLCD_vSendChar( u8 A_u8Data){
	//control RS to send command //connected to A0
	MDIO_vSetPinVal(DIO_PORTA , DIO_PIN0, DIO_HIGH);
	// RW -> write
	MDIO_vSetPinVal(DIO_PORTA , DIO_PIN1 , DIO_LOW);
	// write data
	MDIO_vSetPortVal( DIO_PORTD, A_u8Data);
	//enable pulse
	MDIO_vSetPinVal(DIO_PORTA , DIO_PIN2, DIO_HIGH);
	_delay_ms(1);
	MDIO_vSetPinVal(DIO_PORTA , DIO_PIN2, DIO_LOW);
	_delay_ms(1);

}

void HLCD_SetCursorPos(u8 Rowno, u8 Colno) {
    // Ensure column and row inputs are within valid bounds for a 16x2 LCD
    if (Colno < 16 && Rowno < 2) {
        switch (Rowno) {
            case 0:
                // Row 0 base address is 0x80
                HLCD_vSendCmd(0x80 + Colno);
                break;

            case 1:
                // Row 1 base address is 0xC0 (0x80 + 0x40)
                HLCD_vSendCmd(0xC0 + Colno);
                break;

            default:
                // Handle unexpected row inputs
                break;
        }
    }
}

void HLCD_vWriteCGRAM(u8 A_u8PatternIdx , u8* A_u8PatternValue){

	u8 L_u8Iterator;
	switch(A_u8PatternIdx){
	case 0:
		//set AC on CGRAM
		HLCD_vSendCmd(0x40);
		break;
	case 1 :
		HLCD_vSendCmd(0x48);
		break;
	default:
		break;
	}
	//write pattern
	for( L_u8Iterator = 0 ;  L_u8Iterator < 8 ;  L_u8Iterator++){
	 HLCD_vSendChar(A_u8PatternValue[L_u8Iterator]);
	}

}

void HLCD_vDisplayString(u8 A_u8Str[]){
	u8 L_u8Index = 0;
	for( L_u8Index = 0 ;  L_u8Index !='\0' ;  L_u8Index++){
		 HLCD_vSendChar(A_u8Str[L_u8Index]) ;
	}
}

void HLCD_vPrintNum(u32 A_u32Number){
	u8 L_u8Index= 0;
	u8 L_u8digits[10]= {0} ;
	while(A_u32Number > 0){
		 L_u8digits[ L_u8Index]=(A_u32Number % 10) +"0";
		 A_u32Number =  A_u32Number/10 ;
		 L_u8Index++;
	}
	for(u8 L_u8Index= 9 ; L_u8Index >=0 ; L_u8Index-- ){
		if(L_u8digits[L_u8Index]== 0 ) continue;
		HLCD_vSendChar(L_u8digits[L_u8Index]);
	}
}

void HLCD_vClearScreen(void){
	HLCD_vSendCmd(0x01);
}

